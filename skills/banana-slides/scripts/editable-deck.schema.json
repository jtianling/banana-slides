{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slides"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "aspect_ratio": {
      "enum": [
        "16:9",
        "4:3"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "elements"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          },
          "background": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{6}$"
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "box",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        }
                      ],
                      "items": false
                    },
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "font": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "font_size": {
                      "type": "number",
                      "minimum": 6,
                      "maximum": 120
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^[0-9A-Fa-f]{6}$"
                    },
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "align": {
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "box",
                    "image"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        }
                      ],
                      "items": false
                    },
                    "type": {
                      "const": "image"
                    },
                    "image": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "box",
                    "shape"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        }
                      ],
                      "items": false
                    },
                    "type": {
                      "const": "shape"
                    },
                    "shape": {
                      "enum": [
                        "rect",
                        "ellipse",
                        "arrow"
                      ]
                    },
                    "fill": {
                      "type": "string",
                      "pattern": "^[0-9A-Fa-f]{6}$"
                    },
                    "stroke": {
                      "type": "string",
                      "pattern": "^[0-9A-Fa-f]{6}$"
                    },
                    "stroke_width": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 20
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "box",
                    "rows"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        }
                      ],
                      "items": false
                    },
                    "type": {
                      "const": "table"
                    },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 50,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 30,
                        "items": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      }
                    },
                    "font": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "font_size": {
                      "type": "number",
                      "minimum": 6,
                      "maximum": 120
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^[0-9A-Fa-f]{6}$"
                    },
                    "bold": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "align": {
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type",
                    "box",
                    "chart_type",
                    "categories",
                    "series"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.001,
                          "maximum": 1
                        }
                      ],
                      "items": false
                    },
                    "type": {
                      "const": "chart"
                    },
                    "chart_type": {
                      "enum": [
                        "column",
                        "line",
                        "pie"
                      ]
                    },
                    "categories": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 100,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      }
                    },
                    "series": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "values"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 20000
                          },
                          "values": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 100,
                            "items": {
                              "type": "number",
                              "minimum": -1e+100,
                              "maximum": 1e+100
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
